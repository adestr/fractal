@using System.Diagnostics

<SKCanvasView OnPaintSurface="OnPaintSurface" AdditionalAttributes="attrs"
                IgnorePixelScaling="true" />

@code {

    private const int DefaultTileSize = 100;
    private const int MaxIterations = 100;

    private SKBitmap? bitmap = null;

    /// <summary>
    /// The number of pixels in the width and height of the tile.
    /// </summary>
    [Parameter]
    public int Size { get; set; } = DefaultTileSize;

    /// <summary>
    /// The real part (x-axis) minimum value of the Mandelbrot set to render.
    /// </summary>
    [Parameter]
    public float RealMin { get; set; } = -2.0f;

    /// <summary>
    /// The real part (x-axis) maximum value of the Mandelbrot set to render.
    /// </summary>
    [Parameter]
    public float RealMax { get; set; } = -1.5f;

    /// <summary>
    /// The imaginary part (y-axis) minimum value of the Mandelbrot set to render.
    /// </summary>
    [Parameter]
    public float ImaginaryMin { get; set; } = -0.25f;

    /// <summary>
    /// The imaginary part (y-axis) maximum value of the Mandelbrot set to render.
    /// </summary>
    [Parameter]
    public float ImaginaryMax { get; set; } = 0.25f;

    float pixelWidth;
    float pixelHeight;

    private Dictionary<string, object> attrs = new Dictionary<string, object>
    {
        { "width", DefaultTileSize },
        { "height", DefaultTileSize }
    };

    protected override void OnParametersSet()
    {
        // update attributes and pixel size whenever parameters change
        attrs["width"] = Size;
        attrs["height"] = Size;

        pixelWidth = (RealMax - RealMin) / Size;
        pixelHeight = (ImaginaryMax - ImaginaryMin) / Size;

        // ensure bitmap will be recreated with new size
        bitmap = null;

        base.OnParametersSet();
    }

    protected override async Task OnInitializedAsync()
    {
        // initial pixel sizes (optional — OnParametersSet will also run)
        pixelWidth = (RealMax - RealMin) / Size;
        pixelHeight = (ImaginaryMax - ImaginaryMin) / Size;

        await base.OnInitializedAsync();
    }

    private void OnPaintSurface(SKPaintSurfaceEventArgs e)
    {
        var canvas = e.Surface.Canvas;
        // TODO: Dark mode!
        canvas.Clear(SKColors.White);

        if (bitmap == null)
        {
            bitmap = DrawTile();
        }
        canvas.DrawBitmap(bitmap, new SKRect(0, 0, e.Info.Width, e.Info.Height), new SKRect(0, 0, Size, Size), SKSamplingOptions.Default);
    }

    private SKBitmap DrawTile() 
    {
        Stopwatch watch = new Stopwatch();
        watch.Start();
        Console.WriteLine("Starting to render tile");

        (byte, byte, byte)[] pixelData = new (byte, byte, byte)[Size * Size];
        var bitmap = new SKBitmap(Size, Size);
        for (int x = 0; x < Size; x++)
        {
            for (int y = 0; y < Size; y++)
            {
                var (re, im) = FindCoordinates(x, y);
                int iterations = MandelbrotService.GetMandelbrotIterations(re, im, MaxIterations);

                var colour = GetColour(iterations);
                bitmap.SetPixel(x, y, new SKColor(colour.r, colour.g, colour.b));
            }
        }

        watch.Stop();
        Console.WriteLine($"Finished rendering tile in {watch.ElapsedMilliseconds} ms");

        return bitmap;
    }

    private (float real, float imaginary) FindCoordinates(int x, int y)
    {
        // We want the center of the pixel, not an edge
        float real = RealMin + x * pixelWidth + 0.5f * pixelWidth;
        float imaginary = ImaginaryMin + y * pixelHeight + 0.5f * pixelHeight;
        return (real, imaginary);
    }

    private (byte r, byte g, byte b) GetColour(int mandelbrotValue)
    {
        byte r = (byte)(mandelbrotValue % 256);
        byte g = (byte)((mandelbrotValue * 2) % 256);
        byte b = (byte)((mandelbrotValue * 3) % 256);

        return mandelbrotValue < MaxIterations ? (r, g, b) : ((byte)0, (byte)0, (byte)0);
    }
}
