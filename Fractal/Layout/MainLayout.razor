@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<div class="page-wrapper@(IsMandelbrot ? " view-mandelbrot" : null)">
  <CascadingValue Value="IsMandelbrot" Name="OverMandelbrot">
    <NavMenu />
  </CascadingValue>
  <main>
    @Body
  </main>
</div>

@code {
  private bool IsMandelbrot { get; set; }

  protected override void OnInitialized()
  {
    Navigation.LocationChanged += OnLocationChanged;
    UpdateView();
  }

  private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
  {
    UpdateView();
    _ = InvokeAsync(StateHasChanged);
  }

  private void UpdateView()
  {
    var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
    IsMandelbrot = path.Equals("mandelbrot", StringComparison.OrdinalIgnoreCase);
  }

  public void Dispose()
  {
    Navigation.LocationChanged -= OnLocationChanged;
  }
}